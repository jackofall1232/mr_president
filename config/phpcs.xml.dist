<?xml version="1.0"?>
<ruleset name="Mr. President">
	<description>WordPress Coding Standards for the Mr. President plugin. The engine folder is pure PHP with PSR-style class files, so file-naming and naming-convention sniffs are excluded there.</description>

	<file>../mr-president-game</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_supported_wp_version" value="6.0"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="mr-president-game"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="mrp"/>
				<element value="MRP"/>
				<element value="MrPresident"/>
			</property>
		</properties>
	</rule>

	<!-- The engine is portable PHP: PSR class files, camelCase members, no WordPress. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/engine/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<exclude-pattern>*/engine/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidFunctionName">
		<exclude-pattern>*/engine/*</exclude-pattern>
	</rule>
	<rule ref="Generic.WhiteSpace.DisallowSpaceIndent">
		<exclude-pattern>*/engine/*</exclude-pattern>
	</rule>
	<rule ref="Universal.WhiteSpace.PrecisionAlignment">
		<exclude-pattern>*/engine/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Arrays.ArrayDeclarationSpacing">
		<exclude-pattern>*/engine/*</exclude-pattern>
	</rule>
	<rule ref="PSR2.Classes.PropertyDeclaration"/>
</ruleset>
